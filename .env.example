# Base URL of the running tp-crm application
# local:  http://localhost:5175
# staging: https://<your-staging-host>
BASE_URL=http://localhost:5175

# Client preset the tests should expect — one of:
# demo | logisticsDemo | fieldServiceDemo | wasteDemo
# (the app must be launched with the matching VITE_CLIENT_PRESET)
CLIENT_PRESET=demo

# Data mode the application under test is running in — one of:
# mock     — built-in demo dataset, no login required
# supabase — real auth + database; E2E_* credentials required
# (the app must be launched with the matching VITE_DATA_MODE)
DATA_MODE=mock

# ---------------------------------------------------------------------------
# Test user credentials (supabase mode only — never commit real values).
# The owner account unlocks authenticated read coverage; the other roles
# unlock the role-matrix and write-path tests they are authorised for.
# ---------------------------------------------------------------------------
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_MANAGER_EMAIL=
# E2E_MANAGER_PASSWORD=
# E2E_OFFICE_EMAIL=
# E2E_OFFICE_PASSWORD=
# E2E_FIELD_EMAIL=
# E2E_FIELD_PASSWORD=
# E2E_VIEWER_EMAIL=
# E2E_VIEWER_PASSWORD=
