{
  "name": "tp-crm-tests",
  "version": "1.0.0",
  "description": "Automated end-to-end and regression tests for the tp-crm application",
  "private": true,
  "scripts": {
    "test": "playwright test --grep-invert @live",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:presets": "playwright test tests/presets",
    "test:regression": "playwright test --grep-invert @live",
    "test:live": "playwright test --grep @live",
    "test:driver": "playwright test tests/driver",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PARKINSKI/tp-crm-tests.git"
  },
  "keywords": [
    "playwright",
    "e2e",
    "tests"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  }
}
